# ==============================================================================
# Enterprise Platform — Environment Variables & Infrastructure Secrets Template
# ==============================================================================

# Node & Environment
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# PostgreSQL Production Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ire_admin
POSTGRES_PASSWORD=ire_password_production_secure_2026
POSTGRES_DB=ire_production_db
DATABASE_URL=postgresql+asyncpg://ire_admin:ire_password_production_secure_2026@postgres:5432/ire_production_db

# Redis Cache & Task Queue Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Vector Database (Qdrant / InMemory)
VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL=http://vector-store:6333
VECTOR_DB_API_KEY=

# Event Broker (Kafka / Redpanda)
KAFKA_BROKERS=redpanda:29092

# AI Infrastructure Gateway Provider Keys (Optional / Fallback)
OPENAI_API_KEY=sk-proj-placeholder-key
GEMINI_API_KEY=AIzaSy-placeholder-key
CLAUDE_API_KEY=sk-ant-placeholder-key
DEFAULT_PRIMARY_MODEL=gpt-4o
DEFAULT_FALLBACK_MODELS=gemini-1.5-pro,claude-3-5-sonnet,llama3:70b

# Security & Authentication
JWT_SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# S3 Backup & Recovery Storage
S3_BACKUP_BUCKET=s3://ire-enterprise-backups
BACKUP_ENCRYPTION_KEY=SuperSecretAES256BackupKey2026

# SSL / TLS Termination
SSL_CERT_PATH=/etc/nginx/certs/tls.crt
SSL_KEY_PATH=/etc/nginx/certs/tls.key
