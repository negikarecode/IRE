# Insurance Reasoning Engine (IRE) - Production Environment Template

# ENVIRONMENT & PLATFORM
ENVIRONMENT=production
PROJECT_NAME="Insurance Reasoning Engine"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# SECURITY & AUTHENTICATION (DO NOT COMMIT REAL SECRETS)
SECRET_KEY=generate_with_openssl_rand_hex_32_bit_secure_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET_KEY=generate_with_openssl_rand_hex_32_bit_csrf_secret

# DATABASE CONFIGURATION (POSTGRESQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ire_admin
POSTGRES_PASSWORD=replace_with_strong_production_db_password
POSTGRES_DB=ire_production_db
DATABASE_URL=postgresql+asyncpg://ire_admin:replace_with_strong_production_db_password@postgres:5432/ire_production_db

# REDIS CACHE & LOCK STORE
REDIS_HOST=redis
REDIS_PORT=6379

# VECTOR STORE & AI GATEWAY
VECTOR_DB_URL=http://vector-store:6333
OPENAI_API_KEY=sk-proj-production-key-placeholder
ANTHROPIC_API_KEY=sk-ant-production-key-placeholder

# FILE STORAGE & COMPLIANCE
STORAGE_BACKEND=local
STORAGE_ROOT_PATH=/var/lib/ire/storage
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
